# Workflow Engine Development Environment
# Copy this file to .env and update values as needed

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/workflow_engine
DB_USER=workflow_engine
DB_PASSWORD=workflow_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workflow_engine

# Application
APP_PORT=3000

# Test Database (for integration tests)
TEST_DB_USER=workflow_engine_test
TEST_DB_PASSWORD=test_secret
TEST_DB_HOST=test-db
TEST_DB_PORT=5433
TEST_DB_NAME=workflow_engine_test
