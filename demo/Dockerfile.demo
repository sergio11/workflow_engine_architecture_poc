# ---- Demo Image ----
FROM docker.io/library/clojure:temurin-21-tools-deps

WORKDIR /app

# Copy dependency files first (cache layer)
COPY deps.edn /app/

# Pre-download dependencies
RUN clojure -P

# Copy source code
COPY src /app/src
COPY demo /app/demo
COPY resources /app/resources

# Default: run the demo CLI
CMD ["clojure", "-M:demo", "-m", "demo.core", "--run-all"]
