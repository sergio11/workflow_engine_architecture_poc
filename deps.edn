{:paths ["src" "resources"]

 :version "0.1.0"

 :deps
 {org.clojure/clojure        {:mvn/version "1.11.1"}
  org.clojure/tools.logging  {:mvn/version "1.3.0"}
  org.clojure/core.async     {:mvn/version "1.6.681"}
  ring/ring-core             {:mvn/version "1.11.0"}
  ring/ring-jetty-adapter    {:mvn/version "1.11.0"}
  ring/ring-json             {:mvn/version "0.5.1"}
  metosin/reitit             {:mvn/version "0.7.0"}
  metosin/reitit-ring        {:mvn/version "0.7.0"}
  metosin/reitit-middleware  {:mvn/version "0.7.0"}
  integrant/integrant        {:mvn/version "0.10.0"}
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.909"}
  hikari-cp/hikari-cp        {:mvn/version "3.3.0"}
  org.postgresql/postgresql  {:mvn/version "42.7.1"}
  cheshire/cheshire          {:mvn/version "5.12.0"}}

 :aliases
 {  :test
  {:extra-paths ["test"]
   :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
   :main-opts   ["-m" "kaocha.runner"]}

  :unit
  {:extra-paths ["test"]
   :main-opts   ["-m" "clojure.test"]
   :exec-args   {:dirs ["test"]}
   :exec-fn     clojure.test/run-tests-script}

   :run-test
  {:extra-paths ["test"]
   :main-opts   ["test/run_unit_tests.clj"]}

  :run-integration
  {:extra-paths ["test"]
   :main-opts   ["test/run_integration_tests.clj"]}

   :coverage
   {:extra-paths ["test"]
    :extra-deps  {cloverage/cloverage {:mvn/version "1.2.4"}
                  lambdaisland/kaocha {:mvn/version "1.91.1392"}
                  org.slf4j/slf4j-simple {:mvn/version "2.0.13"}}
    :main-opts   ["-m" "cloverage.coverage"
                  "-p" "src"
                  "-s" "test"
                  "-r" ":clojure.test"
                  "-e" "workflow-engine\\.core$"
                  "--exclude-call" "ring.adapter.jetty/run-jetty"
                  "--exclude-call" "workflow-engine.config.system/start-system!"
                  "--exclude-call" "workflow-engine.config.system/stop-system!"
                  "--exclude-call" "workflow-engine.api.server/start-server!"
                  "--exclude-call" "workflow-engine.api.server/stop-server!"
                  "--exclude-call" "clojure.core/doseq"
                  "--exclude-call" "clojure.core.async/go-loop"
                  "--fail-threshold" "98"
                  "--low-watermark" "99"
                  "--high-watermark" "100"
                  "--html"
                  "--summary"
                  "--junit"]}

   :debug
   {:extra-paths ["test"]
    :main-opts ["test/debug_script.clj"]}

   :demo
   {:extra-paths ["src" "resources" "."]
    :main-opts ["-m" "demo.core"]}

   :demo-repl
   {:extra-paths ["src" "demo"]
    :main-opts ["-m" "nrepl.cmdline"
                "--middleware" "[cider.nrepl/cider-middleware]"]
    :extra-deps {nrepl/nrepl {:mvn/version "1.1.1"}
                 cider/cider-nrepl {:mvn/version "0.49.0"}}}

   :uberjar
   {:extra-paths ["."]
    :extra-deps {org.clojure/tools.build {:mvn/version "0.9.2"}}
    :exec-fn build/uberjar
    :main-opts ["-m" "clojure.main"]}}}
